NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/innobiz_k
# Optional but recommended with Neon/Prisma: non-pooled direct connection for migrations and tests
DIRECT_DATABASE_URL=
APP_BASE_URL=http://localhost:4000
# Optional: if set, test suite will use this DB instead of DATABASE_URL.
# If omitted, the test suite falls back to DIRECT_DATABASE_URL when available.
TEST_DATABASE_URL=
JWT_SECRET=replace-with-very-long-random-string
JWT_EXPIRES_IN=1d

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Optional at this stage, required before email integration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: report share links expiration (days)
REPORT_SHARE_TTL_DAYS=14

# Optional for production document storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
