generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STARTUP
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum EmailTemplateType {
  APPLICATION_RECEIVED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
}

model User {
  id                   String                     @id @default(uuid())
  name                 String
  email                String                     @unique
  passwordHash         String
  role                 Role                       @default(STARTUP)
  failedLoginAttempts  Int                        @default(0)
  lockoutUntil         DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  applications         Application[]              @relation("StartupApplications")
  reviewedApplications Application[]              @relation("ApplicationReviewer")
  statusChanges        ApplicationStatusHistory[] @relation("StatusChangedBy")

  @@index([role])
  @@index([createdAt])
}

model Application {
  id              String                     @id @default(uuid())
  startupId       String
  companyName     String
  sector          String
  stage           String
  description     String
  teamSize        Int?
  fundingNeeded   Decimal?                   @db.Decimal(12, 2)
  status          ApplicationStatus          @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  adminNotes      String?
  rejectionReason String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  startup         User                       @relation("StartupApplications", fields: [startupId], references: [id], onDelete: Cascade)
  reviewedBy      User?                      @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  founders        Founder[]
  documents       Document[]
  emailLogs       EmailLog[]
  statusHistory   ApplicationStatusHistory[]

  @@index([startupId])
  @@index([status])
  @@index([createdAt])
}

model Founder {
  id            String      @id @default(uuid())
  applicationId String
  name          String
  email         String
  phone         String?
  role          String
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([email])
}

model Document {
  id            String      @id @default(uuid())
  applicationId String
  fileName      String
  fileUrl       String
  fileSize      Int
  mimeType      String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model EmailLog {
  id           String            @id @default(uuid())
  applicationId String?
  recipient    String
  templateType EmailTemplateType
  sentAt       DateTime          @default(now())
  delivered    Boolean           @default(false)
  errorMessage String?
  application  Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([recipient])
  @@index([sentAt])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  changedById   String?
  changedAt     DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User?             @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, changedAt])
}
