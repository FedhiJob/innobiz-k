generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STARTUP
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum SupportInterest {
  OFFICE_SPACE
  TRAINING
  FUNDING
  MENTORSHIP
  NETWORKING
  MARKET_ACCESS
  LEGAL_SUPPORT
  PRODUCT_DEVELOPMENT
  INVESTMENT_READINESS
  OTHER
}

enum EmailTemplateType {
  APPLICATION_RECEIVED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  ADMIN_WEEKLY_REPORT
  ADMIN_MONTHLY_REPORT
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  DOCUMENT_UPLOADED
  MONTHLY_REPORT_SUBMITTED
}

model User {
  id                   String                     @id @default(uuid())
  name                 String
  email                String                     @unique
  passwordHash         String
  role                 Role                       @default(STARTUP)
  failedLoginAttempts  Int                        @default(0)
  lockoutUntil         DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  applications         Application[]              @relation("StartupApplications")
  reviewedApplications Application[]              @relation("ApplicationReviewer")
  statusChanges        ApplicationStatusHistory[] @relation("StatusChangedBy")
  reportShares         ReportShare[]
  monthlyReports       MonthlyReport[]
  notifications        Notification[]

  @@index([role])
  @@index([createdAt])
}

model Application {
  id              String                     @id @default(uuid())
  startupId       String
  companyName     String?
  sector          String?
  stage           String?
  description     String?
  teamSize        Int?
  fundingNeeded   Decimal?                   @db.Decimal(12, 2)
  supportInterests SupportInterest[]         @default([])
  status          ApplicationStatus          @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  adminNotes      String?
  rejectionReason String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  startup         User                       @relation("StartupApplications", fields: [startupId], references: [id], onDelete: Cascade)
  reviewedBy      User?                      @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  founders        Founder[]
  documents       Document[]
  emailLogs       EmailLog[]
  statusHistory   ApplicationStatusHistory[]
  monthlyReports  MonthlyReport[]

  @@index([startupId])
  @@index([status])
  @@index([createdAt])
}

model Founder {
  id            String      @id @default(uuid())
  applicationId String
  name          String
  email         String
  phone         String?
  role          String
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([email])
}

model Document {
  id            String      @id @default(uuid())
  applicationId String
  fileName      String
  fileUrl       String
  fileSize      Int
  mimeType      String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model EmailLog {
  id           String            @id @default(uuid())
  applicationId String?
  recipient    String
  templateType EmailTemplateType
  sentAt       DateTime          @default(now())
  delivered    Boolean           @default(false)
  errorMessage String?
  application  Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([recipient])
  @@index([sentAt])
}

model ReportShare {
  id          String   @id @default(uuid())
  token       String   @unique
  startDate   DateTime
  endDate     DateTime
  createdById String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([expiresAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([readAt])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  changedById   String?
  changedAt     DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User?             @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, changedAt])
}

model MonthlyReport {
  id            String      @id @default(uuid())
  applicationId String
  startupId     String
  headline      String
  description   String
  reportMonth   DateTime
  fileName      String
  fileUrl       String
  fileSize      Int
  mimeType      String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  startup       User        @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([applicationId, reportMonth])
  @@index([applicationId])
  @@index([startupId])
  @@index([reportMonth])
}
